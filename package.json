{
  "name": "restaurant",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.10.0",
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "dev:web": "pnpm --filter @restaurant/frontend dev",
    "dev:api": "pnpm --filter @restaurant/backend start:dev",
    "db:generate": "pnpm --filter @restaurant/backend db:generate",
    "db:migrate": "pnpm --filter @restaurant/backend db:migrate",
    "db:seed": "pnpm --filter @restaurant/backend db:seed"
  }
}
